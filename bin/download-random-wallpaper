#!/usr/bin/env bash
set -euo pipefail

fname_prefix=~/Pictures/random
extension=jpg
metadata_fname=/tmp/picsum-metadata.txt

if [ $# -eq 0 ]; then
    echo "Usage: $0 WIDTHxHEIGHT [WIDTHxHEIGHT ...]" >&2
    exit 1
fi

for res in "$@"; do
    if [[ ! $res =~ ^[0-9]+x[0-9]+$ ]]; then
        echo "Error parsing resolution: $res" >&2
        exit 1
    fi
    echo "$res"
done

# The first resolution gets a random image, the rest get the same image by its ID
pic_id=""
for res in "$@"; do
    w=${res%x*}
    h=${res#*x}
    if [ -z "$pic_id" ]; then
        url="https://picsum.photos/$w/$h.$extension"
    else
        url="https://picsum.photos/id/$pic_id/$w/$h.$extension"
    fi
    echo "$url"

    fname="${fname_prefix}_${res}.${extension}"
    headers=$(curl -fsSL --max-time 10 -D - -o "$fname" "$url")
    echo "$fname"

    if [ -z "$pic_id" ]; then
        pic_id=$(echo "$headers" | grep -i '^picsum-id:' | tail -n1 | cut -d' ' -f2 | tr -d '\r')
        echo "Picsum-ID: $pic_id"
        echo "Picsum-ID: $pic_id" >> "$metadata_fname"
    fi
done
